    <Color x:Key="SoftwareFgColor">#5EE0C1</Color>
    <SolidColorBrush x:Key="SoftwareFgBrush" Color="{StaticResource SoftwareFgColor}" />
    <Color x:Key="DocBgColor">#3D1D1D</Color>
    <SolidColorBrush x:Key="DocBgBrush" Color="{StaticResource DocBgColor}" />
    <Color x:Key="DocFgColor">#FF9B9B</Color>
    <SolidColorBrush x:Key="DocFgBrush" Color="{StaticResource DocFgColor}" />
    <Color x:Key="OtherBgColor">#1F2732</Color>
    <SolidColorBrush x:Key="OtherBgBrush" Color="{StaticResource OtherBgColor}" />
    <Color x:Key="OtherFgColor">#C9D3DE</Color>
    <SolidColorBrush x:Key="OtherFgBrush" Color="{StaticResource OtherFgColor}" />
    <Color x:Key="PosterBgColor">#1B2531</Color>
    <SolidColorBrush x:Key="PosterBgBrush" Color="{StaticResource PosterBgColor}" />
</ResourceDictionary>
