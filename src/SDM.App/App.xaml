<Application x:Class="SDM.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SDM.App.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <!-- The palette (Themes/Dark.xaml or Themes/Light.xaml) is inserted first by ThemeManager at startup. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <views:InverseBoolConverter x:Key="InverseBool" />
            <views:EqualsConverter x:Key="Equals" />
            <views:FractionToHeightConverter x:Key="FractionToHeight" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <views:NullToCollapsedConverter x:Key="NullToCollapsed" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
