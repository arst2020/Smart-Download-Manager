<Application x:Class="SDM.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SDM.App.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <views:InverseBoolConverter x:Key="InverseBool" />
        <!-- Vazirmatn is used when installed; Segoe UI covers Latin and has Persian glyphs as fallback. -->
        <FontFamily x:Key="AppFont">Vazirmatn, Segoe UI</FontFamily>

        <Style TargetType="Window" x:Key="AppWindow">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="MinWidth" Value="72" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
        </Style>
    </Application.Resources>
</Application>
