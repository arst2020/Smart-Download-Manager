<Window x:Class="SDM.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SDM.App.Localization"
        Style="{StaticResource AppWindow}"
        Title="{Binding [AppTitle], Source={x:Static loc:Loc.Instance}}"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:Loc.Instance}}"
        Width="1100" Height="620" MinWidth="760" MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Padding="8" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding [Add], Source={x:Static loc:Loc.Instance}}" Command="{Binding AddCommand}" FontWeight="SemiBold" />
                    <Button Content="{Binding [Pause], Source={x:Static loc:Loc.Instance}}" Command="{Binding PauseCommand}" />
                    <Button Content="{Binding [Resume], Source={x:Static loc:Loc.Instance}}" Command="{Binding ResumeCommand}" />
                    <Button Content="{Binding [Remove], Source={x:Static loc:Loc.Instance}}" Command="{Binding RemoveCommand}" />
                    <Button Content="{Binding [OpenFolder], Source={x:Static loc:Loc.Instance}}" Command="{Binding OpenFolderCommand}" />
                    <Button Content="{Binding [Undo], Source={x:Static loc:Loc.Instance}}" Command="{Binding UndoCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ComboBox Width="140" Margin="4,0" SelectedIndex="{Binding FilterIndex}">
                        <ComboBoxItem Content="{Binding [FilterAll], Source={x:Static loc:Loc.Instance}}" />
                        <ComboBoxItem Content="{Binding [FilterActive], Source={x:Static loc:Loc.Instance}}" />
                        <ComboBoxItem Content="{Binding [FilterCompleted], Source={x:Static loc:Loc.Instance}}" />
                    </ComboBox>
                    <Button Content="{Binding [Settings], Source={x:Static loc:Loc.Instance}}" Command="{Binding SettingsCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding TotalSpeed}" />
        </StatusBar>

        <!-- Downloads -->
        <DataGrid ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE"
                  RowHeight="30" BorderThickness="0"
                  MouseDoubleClick="OnRowDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Name}" Width="2*"
                                    Header="{Binding [ColName], Source={x:Static loc:Loc.Instance}}" />
                <DataGridTextColumn Binding="{Binding Size}" Width="90"
                                    Header="{Binding [ColSize], Source={x:Static loc:Loc.Instance}}" />
                <DataGridTemplateColumn Width="150" Header="{Binding [ColProgress], Source={x:Static loc:Loc.Instance}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="4,6">
                                <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" />
                                <TextBlock Text="{Binding PercentText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Binding="{Binding Speed}" Width="100"
                                    Header="{Binding [ColSpeed], Source={x:Static loc:Loc.Instance}}" />
                <DataGridTextColumn Binding="{Binding Remaining}" Width="90"
                                    Header="{Binding [ColEta], Source={x:Static loc:Loc.Instance}}" />
                <DataGridTextColumn Binding="{Binding StatusText}" Width="130"
                                    Header="{Binding [ColStatus], Source={x:Static loc:Loc.Instance}}" />
                <DataGridTextColumn Binding="{Binding Category}" Width="*"
                                    Header="{Binding [ColCategory], Source={x:Static loc:Loc.Instance}}" />
                <DataGridTextColumn Binding="{Binding Folder}" Width="1.5*"
                                    Header="{Binding [ColFolder], Source={x:Static loc:Loc.Instance}}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
