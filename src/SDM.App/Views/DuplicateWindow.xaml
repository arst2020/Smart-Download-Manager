<Window x:Class="SDM.App.Views.DuplicateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SDM.App.Localization"
        Style="{StaticResource AppWindow}"
        Background="{DynamicResource SurfaceBrush}"
        Title="{Binding Heading}"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:Loc.Instance}}"
        Width="580" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" IsChecked="{Binding Remember}"
                          Content="{Binding [DupRemember], Source={x:Static loc:Loc.Instance}}" />
                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource Ghost}" IsCancel="True"
                        Content="{Binding [Cancel], Source={x:Static loc:Loc.Instance}}" Command="{Binding Choose}" CommandParameter="Cancel" />
            </DockPanel>
        </Border>
        <StackPanel Margin="22,20">
            <DockPanel>
                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource WarningBgBrush}" VerticalAlignment="Top" Margin="0,0,14,0">
                    <TextBlock Text="!" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="{Binding Heading}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Existing vs new -->
            <Border Style="{StaticResource InsetCard}" Margin="0,16,0,0" Visibility="{Binding IsBatch, Converter={StaticResource InverseBoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding [DupExisting], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Muted}" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1" Text="{Binding ExistingName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" HorizontalAlignment="Left" ToolTip="{Binding ExistingName}" />
                    <TextBlock Grid.Column="2" Text="{Binding ExistingSize}" Style="{StaticResource Muted}" Margin="12,0,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ExistingFolder}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" HorizontalAlignment="Left" ToolTip="{Binding ExistingFolder}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ExistingDate}" Style="{StaticResource Muted}" FontSize="11" Margin="12,0,0,0" />
                    <TextBlock Grid.Row="2" Text="{Binding [DupNew], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Muted}" Margin="0,10,12,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding NewName}" FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" HorizontalAlignment="Left" ToolTip="{Binding NewName}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding NewSize}" Style="{StaticResource Muted}" Margin="12,10,0,0" />
                </Grid>
            </Border>
            <TextBlock Text="{Binding OthersText}" Style="{StaticResource Muted}" Margin="0,6,0,0"
                       Visibility="{Binding OthersText, Converter={StaticResource NullToCollapsed}}" />

            <!-- Choices -->
            <StackPanel Margin="0,16,0,0">
                <Button Style="{StaticResource Primary}" HorizontalContentAlignment="Stretch" Margin="0,0,0,8" Command="{Binding Choose}" CommandParameter="OpenExisting"
                        Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}" Content="{Binding [DupOpen], Source={x:Static loc:Loc.Instance}}" />
                <Button Style="{StaticResource Primary}" Margin="0,0,0,8" Command="{Binding Choose}" CommandParameter="Resume"
                        Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}" Content="{Binding [DupResume], Source={x:Static loc:Loc.Instance}}" />
                <Button Margin="0,0,0,8" Command="{Binding Choose}" CommandParameter="NewName" Content="{Binding [DupNewName], Source={x:Static loc:Loc.Instance}}" />
                <Button Margin="0,0,0,8" Command="{Binding Choose}" CommandParameter="Replace"
                        Visibility="{Binding CanReplace, Converter={StaticResource BoolToVis}}" Content="{Binding [DupReplace], Source={x:Static loc:Loc.Instance}}" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
