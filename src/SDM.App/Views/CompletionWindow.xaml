<Window x:Class="SDM.App.Views.CompletionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SDM.App.Localization"
        Style="{StaticResource AppWindow}"
        Background="{DynamicResource SurfaceBrush}"
        Title="{Binding [DownloadFinished], Source={x:Static loc:Loc.Instance}}"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:Loc.Instance}}"
        Width="480" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="22,14">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="{Binding [Close], Source={x:Static loc:Loc.Instance}}" Command="{Binding CloseCommand}" IsCancel="True" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Primary}" Command="{Binding RunCommand}" MinHeight="40" Margin="0,0,8,0" IsDefault="True">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource FillIcon}" Data="{StaticResource IconPlay}" />
                                <TextBlock Text="{Binding [Run], Source={x:Static loc:Loc.Instance}}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenFolderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconFolder}" />
                                <TextBlock Text="{Binding [OpenFolder], Source={x:Static loc:Loc.Instance}}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SubtitleCommand}" Margin="8,0,0,0"
                                Visibility="{Binding CanSearchSubtitles, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding [SubtitleSearchTip], Source={x:Static loc:Loc.Instance}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconSearch}" />
                                <TextBlock Text="{Binding [Subtitles], Source={x:Static loc:Loc.Instance}}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
                <CheckBox Margin="0,12,0,0" Content="{Binding [DontShowAgain], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding DontShowAgain}" FontSize="12" />
            </StackPanel>
        </Border>

        <StackPanel Margin="22,20">
            <DockPanel>
                <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource SuccessBgBrush}" TextElement.Foreground="{DynamicResource SuccessBrush}">
                    <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconCheck}" Width="20" Height="20" StrokeThickness="2.6" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [DownloadFinished], Source={x:Static loc:Loc.Instance}}" FontSize="17" FontWeight="Bold" />
                    <TextBlock Text="{Binding Stats}" Style="{StaticResource Muted}" />
                </StackPanel>
            </DockPanel>
            <Border Style="{StaticResource InsetCard}" Margin="0,14,0,0">
                <DockPanel>
                    <Border Style="{StaticResource KindBadge}" Tag="{Binding KindKey}" Width="38" Height="38">
                        <TextBlock Text="{Binding Badge}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding Folder}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight"
                                   HorizontalAlignment="Left" ToolTip="{Binding Folder}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding LibraryNote, Converter={StaticResource NullToCollapsed}}">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding LibraryNote}" Foreground="{DynamicResource SuccessBrush}" FontSize="12" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
