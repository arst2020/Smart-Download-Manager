<Window x:Class="SDM.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SDM.App.Localization"
        Style="{StaticResource AppWindow}"
        Title="{Binding [Settings], Source={x:Static loc:Loc.Instance}}"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:Loc.Instance}}"
        Width="860" Height="660" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,5,12,5" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{Binding [Save], Source={x:Static loc:Loc.Instance}}" IsDefault="True" Click="OnSave" FontWeight="SemiBold" />
            <Button Content="{Binding [Cancel], Source={x:Static loc:Loc.Instance}}" IsCancel="True" />
        </StackPanel>

        <TabControl>
            <!-- ============ General ============ -->
            <TabItem Header="{Binding [TabGeneral], Source={x:Static loc:Loc.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource Label}" Text="{Binding [DownloadDir], Source={x:Static loc:Loc.Instance}}" />
                        <TextBox Grid.Column="1" Text="{Binding DownloadDirectory, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" />
                        <Button Grid.Column="2" Content="{Binding [Browse], Source={x:Static loc:Loc.Instance}}" Command="{Binding BrowseDownloadCommand}" Margin="8,4,0,4" />

                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="{Binding [SeriesDir], Source={x:Static loc:Loc.Instance}}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SeriesDirectory, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" />
                        <Button Grid.Row="1" Grid.Column="2" Content="{Binding [Browse], Source={x:Static loc:Loc.Instance}}" Command="{Binding BrowseSeriesCommand}" Margin="8,4,0,4" />

                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="{Binding [MoviesDir], Source={x:Static loc:Loc.Instance}}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MoviesDirectory, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" />
                        <Button Grid.Row="2" Grid.Column="2" Content="{Binding [Browse], Source={x:Static loc:Loc.Instance}}" Command="{Binding BrowseMoviesCommand}" Margin="8,4,0,4" />

                        <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="{Binding [DefaultConnections], Source={x:Static loc:Loc.Instance}}" />
                        <ComboBox Grid.Row="3" Grid.Column="1" Width="90" HorizontalAlignment="Left" Margin="0,4"
                                  ItemsSource="{Binding ConnectionChoices}" SelectedItem="{Binding Connections}" />

                        <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="{Binding [MaxConcurrent], Source={x:Static loc:Loc.Instance}}" />
                        <TextBox Grid.Row="4" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding MaxConcurrent}" />

                        <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="{Binding [SpeedLimit], Source={x:Static loc:Loc.Instance}}" />
                        <TextBox Grid.Row="5" Grid.Column="1" Width="120" HorizontalAlignment="Left" Text="{Binding SpeedLimit}" />

                        <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="{Binding [Proxy], Source={x:Static loc:Loc.Instance}}" />
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding ProxyUrl}" FlowDirection="LeftToRight" />

                        <TextBlock Grid.Row="7" Style="{StaticResource Label}" Text="{Binding [Language], Source={x:Static loc:Loc.Instance}}" />
                        <ComboBox Grid.Row="7" Grid.Column="1" Width="160" HorizontalAlignment="Left" Margin="0,4"
                                  ItemsSource="{Binding Languages}" DisplayMemberPath="Name"
                                  SelectedValuePath="Code" SelectedValue="{Binding Language}" />

                        <CheckBox Grid.Row="8" Grid.ColumnSpan="3" Margin="0,10,0,4"
                                  Content="{Binding [AutoOrganize], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding AutoOrganize}" />
                        <CheckBox Grid.Row="9" Grid.ColumnSpan="3" Margin="0,4"
                                  Content="{Binding [RenameStandard], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding RenameToStandard}" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ============ AI + TMDB ============ -->
            <TabItem Header="{Binding [TabSmart], Source={x:Static loc:Loc.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource Label}" Text="{Binding [AiProvider], Source={x:Static loc:Loc.Instance}}" />
                            <ComboBox Grid.Column="1" Margin="0,4" Width="340" HorizontalAlignment="Left"
                                      ItemsSource="{Binding AiProviders}" DisplayMemberPath="Name"
                                      SelectedValuePath="Value" SelectedValue="{Binding AiProvider}" />

                            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="{Binding [ApiKey], Source={x:Static loc:Loc.Instance}}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AiApiKey}" FlowDirection="LeftToRight" IsEnabled="{Binding AiNeedsKey}" />

                            <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="{Binding [Model], Source={x:Static loc:Loc.Instance}}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AiModel}" FlowDirection="LeftToRight" />

                            <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="{Binding [BaseUrl], Source={x:Static loc:Loc.Instance}}" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AiBaseUrl}" FlowDirection="LeftToRight" />

                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Hint}" Text="{Binding AiDefaults}" FlowDirection="LeftToRight" />
                        </Grid>
                        <CheckBox Content="{Binding [AiAlways], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding AiAlways}" Margin="0,4" />
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding [AiHint], Source={x:Static loc:Loc.Instance}}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding [Test], Source={x:Static loc:Loc.Instance}}" Command="{Binding TestAiCommand}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding AiTestResult}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="600" />
                        </StackPanel>

                        <Separator Margin="0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="{Binding [TmdbKey], Source={x:Static loc:Loc.Instance}}" />
                            <TextBox Grid.Column="1" Text="{Binding TmdbApiKey}" FlowDirection="LeftToRight" />
                            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="{Binding [TmdbLanguage], Source={x:Static loc:Loc.Instance}}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Width="120" HorizontalAlignment="Left" Text="{Binding TmdbLanguage}" FlowDirection="LeftToRight" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding [TmdbHint], Source={x:Static loc:Loc.Instance}}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding [Test], Source={x:Static loc:Loc.Instance}}" Command="{Binding TestTmdbCommand}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding TmdbTestResult}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="600" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Media server ============ -->
            <TabItem Header="{Binding [TabMediaServer], Source={x:Static loc:Loc.Instance}}">
                <StackPanel Margin="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="{Binding [ServerType], Source={x:Static loc:Loc.Instance}}" />
                        <ComboBox Grid.Column="1" Margin="0,4" Width="200" HorizontalAlignment="Left"
                                  ItemsSource="{Binding ServerTypes}" DisplayMemberPath="Name"
                                  SelectedValuePath="Value" SelectedValue="{Binding ServerType}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="{Binding [ServerUrl], Source={x:Static loc:Loc.Instance}}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ServerUrl}" FlowDirection="LeftToRight" />
                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="{Binding [ServerKey], Source={x:Static loc:Loc.Instance}}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ServerApiKey}" FlowDirection="LeftToRight" />
                    </Grid>
                    <CheckBox Content="{Binding [ServerRefresh], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding ServerRefresh}" Margin="0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="{Binding [Test], Source={x:Static loc:Loc.Instance}}" Command="{Binding TestServerCommand}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding ServerTestResult}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="640" FlowDirection="LeftToRight" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- ============ Topics / rules ============ -->
            <TabItem Header="{Binding [TabRules], Source={x:Static loc:Loc.Instance}}">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="{Binding [RulesHint], Source={x:Static loc:Loc.Instance}}" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{Binding [AddRule], Source={x:Static loc:Loc.Instance}}" Command="{Binding AddRuleCommand}" Margin="0,0,4,0" />
                        <Button Content="{Binding [DeleteRule], Source={x:Static loc:Loc.Instance}}" Command="{Binding DeleteRuleCommand}" />
                        <Button Content="{Binding [Browse], Source={x:Static loc:Loc.Instance}}" Command="{Binding BrowseRuleCommand}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}"
                              AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="50"
                                                    Header="{Binding [RuleEnabled], Source={x:Static loc:Loc.Instance}}" />
                            <DataGridTextColumn Binding="{Binding Name}" Width="*"
                                                Header="{Binding [RuleName], Source={x:Static loc:Loc.Instance}}" />
                            <DataGridTextColumn Binding="{Binding Keywords}" Width="1.5*"
                                                Header="{Binding [RuleKeywords], Source={x:Static loc:Loc.Instance}}" />
                            <DataGridTextColumn Binding="{Binding Domains}" Width="*"
                                                Header="{Binding [RuleDomains], Source={x:Static loc:Loc.Instance}}" />
                            <DataGridTextColumn Binding="{Binding TargetFolder}" Width="2*"
                                                Header="{Binding [RuleTarget], Source={x:Static loc:Loc.Instance}}" />
                            <DataGridCheckBoxColumn Binding="{Binding SeasonSubfolders, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                                    Header="{Binding [RuleSeason], Source={x:Static loc:Loc.Instance}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
