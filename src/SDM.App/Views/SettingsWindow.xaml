<Window x:Class="SDM.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SDM.App.Localization"
        Style="{StaticResource AppWindow}"
        Background="{DynamicResource SurfaceBrush}"
        Title="{Binding [Settings], Source={x:Static loc:Loc.Instance}}"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:Loc.Instance}}"
        Width="980" Height="700" MinWidth="820" MinHeight="560" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Provider cards: a ListBox whose selection is the provider. -->
        <Style x:Key="ProviderItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" CornerRadius="12" Padding="12" MinHeight="58" BorderThickness="1"
                                Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource LineBrush}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Section" TargetType="StackPanel">
            <Setter Property="Margin" Value="26,22" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="26,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Ghost}" Content="{Binding [Cancel], Source={x:Static loc:Loc.Instance}}" IsCancel="True" Margin="0,0,10,0" />
                <Button Style="{StaticResource Primary}" Content="{Binding [Save], Source={x:Static loc:Loc.Instance}}" IsDefault="True" Click="OnSave" />
            </StackPanel>
        </Border>

        <TabControl Style="{StaticResource SideTabs}" Tag="{Binding [Settings], Source={x:Static loc:Loc.Instance}}">
            <!-- ============ General ============ -->
            <TabItem Style="{StaticResource SideTab}" Header="{Binding [TabGeneral], Source={x:Static loc:Loc.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="{Binding [TabGeneral], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Heading}" Margin="0,0,0,18" />

                        <TextBlock Text="{Binding [Theme], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="theme" Content="{Binding [ThemeSystem], Source={x:Static loc:Loc.Instance}}"
                                             IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=System}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="theme" Content="{Binding [ThemeDark], Source={x:Static loc:Loc.Instance}}"
                                             IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Dark}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="theme" Content="{Binding [ThemeLight], Source={x:Static loc:Loc.Instance}}"
                                             IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Light}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding [Language], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                        <ComboBox Width="200" HorizontalAlignment="Left" ItemsSource="{Binding Languages}" DisplayMemberPath="Name"
                                  SelectedValuePath="Code" SelectedValue="{Binding Language}" />

                        <TextBlock Text="{Binding [DownloadDir], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{Binding [Browse], Source={x:Static loc:Loc.Instance}}" Command="{Binding BrowseDownloadCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding DownloadDirectory, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" />
                        </DockPanel>
                        <TextBlock Text="{Binding [SeriesDir], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{Binding [Browse], Source={x:Static loc:Loc.Instance}}" Command="{Binding BrowseSeriesCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding SeriesDirectory, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" />
                        </DockPanel>
                        <TextBlock Text="{Binding [MoviesDir], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{Binding [Browse], Source={x:Static loc:Loc.Instance}}" Command="{Binding BrowseMoviesCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding MoviesDirectory, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" />
                        </DockPanel>

                        <Border Style="{StaticResource InsetCard}" Margin="0,18,0,0">
                            <StackPanel>
                                <CheckBox Style="{StaticResource Switch}" Content="{Binding [AutoOrganize], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding AutoOrganize}" />
                                <Separator Margin="0,10" Background="{DynamicResource LineBrush}" />
                                <CheckBox Style="{StaticResource Switch}" Content="{Binding [RenameStandard], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding RenameToStandard}" />
                                <Separator Margin="0,10" Background="{DynamicResource LineBrush}" />
                                <CheckBox Style="{StaticResource Switch}" Content="{Binding [ShowCompletion], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding ShowCompletionDialog}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Connection ============ -->
            <TabItem Style="{StaticResource SideTab}" Header="{Binding [TabConnection], Source={x:Static loc:Loc.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="{Binding [TabConnection], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Heading}" Margin="0,0,0,18" />
                        <TextBlock Text="{Binding [DefaultConnections], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource SegmentHost}" FlowDirection="LeftToRight">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="sconn" Content="1" IsChecked="{Binding Connections, Converter={StaticResource Equals}, ConverterParameter=1}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="sconn" Content="4" IsChecked="{Binding Connections, Converter={StaticResource Equals}, ConverterParameter=4}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="sconn" Content="8" IsChecked="{Binding Connections, Converter={StaticResource Equals}, ConverterParameter=8}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="sconn" Content="16" IsChecked="{Binding Connections, Converter={StaticResource Equals}, ConverterParameter=16}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="sconn" Content="32" IsChecked="{Binding Connections, Converter={StaticResource Equals}, ConverterParameter=32}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding [MaxConcurrent], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                        <TextBox Text="{Binding MaxConcurrent}" Width="100" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding [SpeedLimit], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                        <TextBox Text="{Binding SpeedLimit}" Width="160" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding [Proxy], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                        <TextBox Text="{Binding ProxyUrl}" FlowDirection="LeftToRight" />

                        <Border Style="{StaticResource InsetCard}" Margin="0,22,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding OpenSchedulerCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconClock}" />
                                        <TextBlock Text="{Binding [ScheduleEllipsis], Source={x:Static loc:Loc.Instance}}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [Schedule], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ScheduleSummary}" Style="{StaticResource Muted}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ AI + TMDB ============ -->
            <TabItem Style="{StaticResource SideTab}" Header="{Binding [TabSmart], Source={x:Static loc:Loc.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="{Binding [TabSmart], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Heading}" />
                        <TextBlock Text="{Binding [AiHint], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Muted}" Margin="0,4,0,18" />

                        <TextBlock Text="{Binding [AiProvider], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                        <ListBox ItemsSource="{Binding AiProviders}" SelectedValuePath="Value" SelectedValue="{Binding AiProvider}"
                                 ItemContainerStyle="{StaticResource ProviderItem}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource NavActiveBrush}">
                                            <TextBlock Text="{Binding Badge}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" FontSize="11" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding [ApiKey], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding AiApiKey}" FlowDirection="LeftToRight" IsEnabled="{Binding AiNeedsKey}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding [Model], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding AiModel}" FlowDirection="LeftToRight" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding [BaseUrl], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                        <TextBox Text="{Binding AiBaseUrl}" FlowDirection="LeftToRight" />
                        <TextBlock Text="{Binding AiDefaults}" Style="{StaticResource Muted}" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,4,0,0" />

                        <Border Style="{StaticResource InsetCard}" Margin="0,14,0,0">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AiAlways}">
                                <StackPanel>
                                    <TextBlock Text="{Binding [AiAlways], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding [AiAlwaysHint], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Muted}" />
                                </StackPanel>
                            </CheckBox>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{Binding [TestConnection], Source={x:Static loc:Loc.Instance}}" Command="{Binding TestAiCommand}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding AiTestResult}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
                        </StackPanel>

                        <Separator Margin="0,20" Background="{DynamicResource LineBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding [TmdbKey], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding TmdbApiKey}" FlowDirection="LeftToRight" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding [TmdbLanguageShort], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding TmdbLanguage}" FlowDirection="LeftToRight" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding [TmdbHint], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{Binding [TestConnection], Source={x:Static loc:Loc.Instance}}" Command="{Binding TestTmdbCommand}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding TmdbTestResult}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Media server ============ -->
            <TabItem Style="{StaticResource SideTab}" Header="{Binding [TabMediaServer], Source={x:Static loc:Loc.Instance}}">
                <StackPanel Style="{StaticResource Section}">
                    <TextBlock Text="{Binding [TabMediaServer], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Heading}" Margin="0,0,0,18" />
                    <TextBlock Text="{Binding [ServerType], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                    <ComboBox Width="220" HorizontalAlignment="Left" ItemsSource="{Binding ServerTypes}" DisplayMemberPath="Name"
                              SelectedValuePath="Value" SelectedValue="{Binding ServerType}" />
                    <TextBlock Text="{Binding [ServerUrl], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                    <TextBox Text="{Binding ServerUrl}" FlowDirection="LeftToRight" />
                    <TextBlock Text="{Binding [ServerKey], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                    <TextBox Text="{Binding ServerApiKey}" FlowDirection="LeftToRight" />
                    <Border Style="{StaticResource InsetCard}" Margin="0,16,0,0">
                        <CheckBox Style="{StaticResource Switch}" Content="{Binding [ServerRefresh], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding ServerRefresh}" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{Binding [TestConnection], Source={x:Static loc:Loc.Instance}}" Command="{Binding TestServerCommand}" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding ServerTestResult}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560" FlowDirection="LeftToRight" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- ============ Browser ============ -->
            <TabItem Style="{StaticResource SideTab}" Header="{Binding [TabBrowser], Source={x:Static loc:Loc.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="{Binding [TabBrowser], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Heading}" />
                        <TextBlock Text="{Binding [BrowserHint], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Muted}" Margin="0,4,0,16" />

                        <Border Style="{StaticResource InsetCard}">
                            <CheckBox Style="{StaticResource Switch}" Content="{Binding [BrowserCapture], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding BrowserIntegration}" />
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="{Binding [RegisterAgain], Source={x:Static loc:Loc.Instance}}" Command="{Binding RegisterBrowserCommand}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding BrowserStatus}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
                        </StackPanel>

                        <TextBlock Text="{Binding [InstallSteps], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" Margin="0,22,0,8" />
                        <Border Style="{StaticResource InsetCard}">
                            <StackPanel>
                                <TextBlock Text="{Binding [InstallStep1], Source={x:Static loc:Loc.Instance}}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding [InstallStep2], Source={x:Static loc:Loc.Instance}}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding [InstallStep3], Source={x:Static loc:Loc.Instance}}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{Binding [OpenFolder], Source={x:Static loc:Loc.Instance}}" Command="{Binding OpenExtensionFolderCommand}" Margin="8,0,0,0" />
                                    <Button DockPanel.Dock="Right" Content="{Binding [CopyPath], Source={x:Static loc:Loc.Instance}}" Command="{Binding CopyExtensionPathCommand}" Margin="8,0,0,0" />
                                    <TextBox Text="{Binding ExtensionFolder, Mode=OneWay}" IsReadOnly="True" FlowDirection="LeftToRight" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                                    <Run Text="Extension ID: " /><Run Text="{Binding ExtensionId, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding [ExtraIds], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                        <TextBox Text="{Binding ExtraExtensionIds}" FlowDirection="LeftToRight" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Topics / rules ============ -->
            <TabItem Style="{StaticResource SideTab}" Header="{Binding [TabRules], Source={x:Static loc:Loc.Instance}}">
                <DockPanel Margin="26,22">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding [TabRules], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Heading}" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding [RulesHint], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Muted}" Margin="0,4,0,12" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{Binding [AddRule], Source={x:Static loc:Loc.Instance}}" Command="{Binding AddRuleCommand}" Margin="0,0,8,0" />
                        <Button Content="{Binding [DeleteRule], Source={x:Static loc:Loc.Instance}}" Command="{Binding DeleteRuleCommand}" Margin="0,0,8,0" />
                        <Button Content="{Binding [Browse], Source={x:Static loc:Loc.Instance}}" Command="{Binding BrowseRuleCommand}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="50"
                                                    Header="{Binding [RuleEnabled], Source={x:Static loc:Loc.Instance}}" />
                            <DataGridTextColumn Binding="{Binding Name}" Width="*" Header="{Binding [RuleName], Source={x:Static loc:Loc.Instance}}" />
                            <DataGridTextColumn Binding="{Binding Keywords}" Width="1.5*" Header="{Binding [RuleKeywords], Source={x:Static loc:Loc.Instance}}" />
                            <DataGridTextColumn Binding="{Binding Domains}" Width="*" Header="{Binding [RuleDomains], Source={x:Static loc:Loc.Instance}}" />
                            <DataGridTextColumn Binding="{Binding TargetFolder}" Width="2*" Header="{Binding [RuleTarget], Source={x:Static loc:Loc.Instance}}" />
                            <DataGridCheckBoxColumn Binding="{Binding SeasonSubfolders, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                                    Header="{Binding [RuleSeason], Source={x:Static loc:Loc.Instance}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
