<Window x:Class="SDM.App.Views.BatchAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SDM.App.Localization"
        Style="{StaticResource AppWindow}"
        Background="{DynamicResource SurfaceBrush}"
        Title="{Binding [BatchTitle], Source={x:Static loc:Loc.Instance}}"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:Loc.Instance}}"
        Width="780" Height="760" MinWidth="640" MinHeight="520" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="22,16">
            <StackPanel>
                <TextBlock Text="{Binding [BatchTitle], Source={x:Static loc:Loc.Instance}}" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="{Binding Header}" Style="{StaticResource Muted}" />
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="22,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding PasteAgainCommand}" MinHeight="34" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconClipboard}" Width="14" Height="14" />
                            <TextBlock Text="{Binding [PasteAgain], Source={x:Static loc:Loc.Instance}}" Margin="6,0,0,0" FontSize="13" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Chip}" Command="{Binding SelectAllCommand}" Content="{Binding SelectAllText}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="22,14">
            <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource Ghost}" Content="{Binding [Cancel], Source={x:Static loc:Loc.Instance}}" IsCancel="True" MinHeight="44" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Click="OnSchedule" MinHeight="44" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconClock}" />
                            <TextBlock Text="{Binding [ScheduleEllipsis], Source={x:Static loc:Loc.Instance}}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Content="{Binding [AddToQueue], Source={x:Static loc:Loc.Instance}}" Click="OnQueue" MinHeight="44" Margin="0,0,10,0" />
                    <Button Style="{StaticResource Primary}" Content="{Binding StartText}" IsDefault="True" Click="OnStart" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Shared options -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="22,14">
            <WrapPanel>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="{Binding [ConnectionsPerFile], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" FontSize="12" />
                    <Border Style="{StaticResource SegmentHost}" FlowDirection="LeftToRight">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" GroupName="bconn" Content="1" IsChecked="{Binding Connections, Converter={StaticResource Equals}, ConverterParameter=1}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="bconn" Content="4" IsChecked="{Binding Connections, Converter={StaticResource Equals}, ConverterParameter=4}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="bconn" Content="8" IsChecked="{Binding Connections, Converter={StaticResource Equals}, ConverterParameter=8}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="bconn" Content="16" IsChecked="{Binding Connections, Converter={StaticResource Equals}, ConverterParameter=16}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="bconn" Content="32" IsChecked="{Binding Connections, Converter={StaticResource Equals}, ConverterParameter=32}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Margin="0,0,20,0" Visibility="{Binding HasQueues, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding [Queue], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" FontSize="12" />
                    <ComboBox Width="160" ItemsSource="{Binding QueueOptions}" DisplayMemberPath="Name"
                              SelectedValuePath="Id" SelectedValue="{Binding QueueId}" />
                </StackPanel>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="{Binding [Simultaneous], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" FontSize="12" />
                    <Border Style="{StaticResource SegmentHost}" FlowDirection="LeftToRight">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" GroupName="bpar" Content="1" IsChecked="{Binding Concurrent, Converter={StaticResource Equals}, ConverterParameter=1}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="bpar" Content="3" IsChecked="{Binding Concurrent, Converter={StaticResource Equals}, ConverterParameter=3}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="bpar" Content="5" IsChecked="{Binding Concurrent, Converter={StaticResource Equals}, ConverterParameter=5}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <CheckBox Content="{Binding [StandardName], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding RenameToStandard}" VerticalAlignment="Bottom" Margin="0,0,0,10" />
            </WrapPanel>
        </Border>

        <!-- Links -->
        <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding Items}" Padding="14,10">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource BareItem}">
                    <Setter Property="Margin" Value="0,0,0,6" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource InsetCard}" Padding="10">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Include}" VerticalAlignment="Center" Margin="0,0,12,0"
                                      AutomationProperties.Name="{Binding Title}" />
                            <Border DockPanel.Dock="Left" Style="{StaticResource KindBadge}" Tag="{Binding KindKey}" Width="34" Height="34" CornerRadius="9">
                                <TextBlock Text="{Binding Badge}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border DockPanel.Dock="Right" Style="{StaticResource StatusTag}" Tag="{Binding KindKey}" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="{Binding Tag}" />
                            </Border>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" FontSize="12" Foreground="{DynamicResource Text2Brush}"
                                       MinWidth="64" TextAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight" />
                            <StackPanel Margin="12,0">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Destination}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           FlowDirection="LeftToRight" HorizontalAlignment="Left" ToolTip="{Binding Destination}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
