<Window x:Class="SDM.App.Views.SchedulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SDM.App.Localization"
        Style="{StaticResource AppWindow}"
        Background="{DynamicResource SurfaceBrush}"
        Title="{Binding [Schedule], Source={x:Static loc:Loc.Instance}}"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:Loc.Instance}}"
        Width="760" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="22,16">
            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}">
                <StackPanel>
                    <TextBlock Text="{Binding [Schedule], Source={x:Static loc:Loc.Instance}}" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="{Binding [ScheduleHint], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Muted}" />
                </StackPanel>
            </CheckBox>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="22,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Ghost}" Content="{Binding [Cancel], Source={x:Static loc:Loc.Instance}}" IsCancel="True" Margin="0,0,10,0" />
                <Button Style="{StaticResource Primary}" Content="{Binding [Save], Source={x:Static loc:Loc.Instance}}" IsDefault="True" Click="OnSave"
                        IsEnabled="{Binding IsValid}" />
            </StackPanel>
        </Border>

        <StackPanel Margin="22,20" IsEnabled="{Binding Enabled}">
            <!-- Times -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding [StartTime], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Start, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" FontSize="20" FontWeight="SemiBold"
                             MinHeight="48" TextAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding [StopTime], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Stop, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" FontSize="20" FontWeight="SemiBold"
                             MinHeight="48" TextAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- 24 h timeline -->
            <ItemsControl ItemsSource="{Binding Hours}" FlowDirection="LeftToRight" Margin="0,16,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Border x:Name="Cell" Height="26" Margin="1,0" CornerRadius="3" Background="{DynamicResource InputBrush}" />
                            <TextBlock Text="{Binding Hour}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                <Setter TargetName="Cell" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Days -->
            <TextBlock Text="{Binding [Days], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" Margin="0,18,0,8" />
            <ItemsControl ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton Style="{StaticResource Pill}" Content="{Binding Label}" IsChecked="{Binding IsOn}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Options -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding [ScheduleSpeed], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding SpeedLimits}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding SpeedLimit}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding [AfterQueue], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding AfterActions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding After}" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource InsetCard}" Margin="0,16,0,0">
                <CheckBox Content="{Binding [PauseAtEnd], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding PauseAtEnd}" />
            </Border>

            <Border Margin="0,12,0,0" CornerRadius="12" Padding="14,12" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconClock}" Stroke="{DynamicResource AccentBrush}" Width="18" Height="18" />
                    <TextBlock Text="{Binding NextStartText}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
