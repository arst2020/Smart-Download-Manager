<Window x:Class="SDM.App.Views.AddDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SDM.App.Localization"
        Style="{StaticResource AppWindow}"
        Title="{Binding [Add], Source={x:Static loc:Loc.Instance}}"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:Loc.Instance}}"
        Width="680" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Loaded="OnLoaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <StackPanel Margin="16">
        <!-- Link -->
        <TextBlock Text="{Binding [Url], Source={x:Static loc:Loc.Instance}}" Margin="0,0,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="{Binding [Analyze], Source={x:Static loc:Loc.Instance}}"
                    Command="{Binding AnalyzeCommand}" Margin="8,0,0,0" />
            <!-- URLs are always left-to-right, even in the Persian UI. -->
            <TextBox x:Name="UrlBox" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" />
        </DockPanel>
        <TextBlock Text="{Binding Status}" Foreground="#666" Margin="0,4,0,0" TextWrapping="Wrap" />

        <!-- Suggestion -->
        <Border Margin="0,10,0,0" Padding="12" Background="#F3F6FB" BorderBrush="#C9D6EA" BorderThickness="1" CornerRadius="6"
                Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Details}" Margin="0,2,0,0" />
                <TextBlock Text="{Binding Source}" Foreground="#555" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Reason}" Foreground="#555" FontSize="12" FontStyle="Italic" TextWrapping="Wrap" FlowDirection="LeftToRight" />
                <TextBlock Text="{Binding Warning}" Foreground="#B45309" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />

                <TextBlock Text="{Binding [SuggestedFolder], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" Margin="0,10,0,4" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{Binding [Browse], Source={x:Static loc:Loc.Instance}}"
                            Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
                    <TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" />
                </DockPanel>
                <DockPanel Margin="0,6,0,0">
                    <TextBlock Text="{Binding [OtherPlaces], Source={x:Static loc:Loc.Instance}}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding FolderOptions}" SelectedItem="{Binding SelectedOption}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="  " />
                                    <Run Text="{Binding Folder, Mode=OneWay}" Foreground="#666" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </DockPanel>

                <!-- Naming -->
                <StackPanel Margin="0,10,0,0" Visibility="{Binding CanRename, Converter={StaticResource BoolToVis}}">
                    <CheckBox Content="{Binding [RenameStandard], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding RenameToStandard}" />
                    <TextBlock Margin="22,2,0,0" FontSize="12" Foreground="#555" FlowDirection="LeftToRight" TextWrapping="Wrap">
                        <Run Text="{Binding OriginalName, Mode=OneWay}" />
                        <Run Text="  →  " />
                        <Run Text="{Binding StandardName, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
                <CheckBox Margin="0,8,0,0" Content="{Binding [RememberRule], Source={x:Static loc:Loc.Instance}}"
                          IsChecked="{Binding RememberRule}" Visibility="{Binding CanRemember, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <!-- File name + connections -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding [FileName], Source={x:Static loc:Loc.Instance}}" Margin="0,0,0,4" />
                <TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{Binding [Connections], Source={x:Static loc:Loc.Instance}}" Margin="0,0,0,4" />
                <ComboBox Width="90" ItemsSource="{Binding ConnectionChoices}" SelectedItem="{Binding Connections}" />
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{Binding [Start], Source={x:Static loc:Loc.Instance}}" IsDefault="True"
                    Click="OnStart" FontWeight="SemiBold" />
            <Button Content="{Binding [Cancel], Source={x:Static loc:Loc.Instance}}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
